# -------------------------------------------------------
# Travel Planner Web Application — Environment Variables
# -------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# Never commit .env.local to version control.
# -------------------------------------------------------

# Base URL of the backend API (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# Enable mock auth during backend downtime (default is false)
# VITE_USE_MOCK_AUTH=false

# Mapbox Public Access Token for 3D Globe & Map
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Frankfurter Exchange Rate API (free, no key needed)
VITE_FRANKFURTER_API_URL=https://api.frankfurter.dev
